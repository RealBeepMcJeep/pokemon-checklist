{
  "name": "pokemon-checklist",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "validate:data": "python tools/validate_data.py",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run validate:data && vite build && node tools/publish.mjs",
    "build:check": "npm run validate:data && vite build && node tools/publish.mjs --check",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build:check"
  },
  "dependencies": {
    "@preact/signals": "^2.11.2",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^22.20.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.1"
  }
}
